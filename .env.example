# Generate a long random secret. Set the SAME value in Vercel and every GoldenStore server.
GOLDENSTORE_API_KEY=replace-with-a-long-random-secret-at-least-32-chars
# Create a Neon/Vercel Postgres database and paste its pooled connection string here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Optional: comma-separated origins for browser dashboards. Use * only for public read-only use.
CORS_ORIGIN=https://your-dashboard.example
